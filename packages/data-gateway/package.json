    "morgan": "^1.10.0",
    "mysql2": "^3.14.1",
    "ono": "^7.1.3",
    "oracledb": "^6.8.0",
    "pg": "^8.16.0",
    "prom-client": "^15.1.3",
    "sql.js": "^1.9.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
