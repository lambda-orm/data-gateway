{
	"transform": {
		"^.+\\.(t|j)sx?$": ["ts-jest", {
			"tsconfig": "tsconfig.json"
		}]
	},
	"testMatch": [
		"**/__tests__/*.test.ts",
		"**/__tests__/*/*.test.ts"
	],
	"moduleFileExtensions": [
		"ts",
		"js",
		"json",
		"node"
	],
	"moduleNameMapper": {
		"^@lambdaorm/base$": "<rootDir>/../../packages/base/build",
		"^@lambdaorm/base/(.*)$": "<rootDir>/../../packages/base/build/$1",
		"^@lambdaorm/lib$": "<rootDir>/../../packages/lib/build",
		"^@lambdaorm/lib/(.*)$": "<rootDir>/../../packages/lib/build/$1"
	}
}
