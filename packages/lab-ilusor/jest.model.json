{
	"rootDir": ".",
	"testMatch": [
		"<rootDir>/tests/model.spec.ts"
	],
	"testTimeout": 30000,
	"maxWorkers": 1,
	"transform": {
		"^.+\\.ts$": [
			"ts-jest",
			{
				"tsconfig": "<rootDir>/tsconfig.json",
				"diagnostics": false
			}
		]
	},
	"moduleFileExtensions": [
		"ts",
		"js",
		"json",
		"node"
	]
}
