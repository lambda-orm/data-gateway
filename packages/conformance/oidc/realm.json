{
 "realm": "data-gateway",
 "enabled": true,
 "sslRequired": "none",
 "accessTokenLifespan": 300,
 "roles": {
  "realm": [
   {
    "name": "reader"
   },
   {
    "name": "backend"
   },
   {
    "name": "sales"
   }
  ]
 },
 "clients": [
  {
   "clientId": "data-gateway-ide",
   "name": "λORM Data Gateway IDE",
   "publicClient": true,
   "standardFlowEnabled": true,
   "directAccessGrantsEnabled": false,
   "redirectUris": [
    "http://127.0.0.1:*",
    "http://localhost:*",
    "app://ide/*"
   ],
   "webOrigins": [
    "+"
   ],
   "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "+"
   },
   "protocolMappers": [
    {
     "name": "audience data-gateway",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-audience-mapper",
     "config": {
      "included.custom.audience": "data-gateway",
      "access.token.claim": "true",
      "id.token.claim": "false",
      "introspection.token.claim": "true"
     }
    },
    {
     "name": "roles",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-usermodel-realm-role-mapper",
     "config": {
      "claim.name": "roles",
      "multivalued": "true",
      "jsonType.label": "String",
      "access.token.claim": "true",
      "id.token.claim": "true",
      "userinfo.token.claim": "true",
      "introspection.token.claim": "true"
     }
    },
    {
     "name": "country",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-usermodel-attribute-mapper",
     "config": {
      "user.attribute": "country",
      "claim.name": "country",
      "jsonType.label": "String",
      "access.token.claim": "true",
      "id.token.claim": "true",
      "userinfo.token.claim": "true",
      "introspection.token.claim": "true"
     }
    }
   ]
  },
  {
   "clientId": "conformance",
   "publicClient": true,
   "standardFlowEnabled": false,
   "directAccessGrantsEnabled": true,
   "protocolMappers": [
    {
     "name": "audience data-gateway",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-audience-mapper",
     "config": {
      "included.custom.audience": "data-gateway",
      "access.token.claim": "true",
      "id.token.claim": "false",
      "introspection.token.claim": "true"
     }
    },
    {
     "name": "roles",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-usermodel-realm-role-mapper",
     "config": {
      "claim.name": "roles",
      "multivalued": "true",
      "jsonType.label": "String",
      "access.token.claim": "true",
      "id.token.claim": "true",
      "userinfo.token.claim": "true",
      "introspection.token.claim": "true"
     }
    },
    {
     "name": "country",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-usermodel-attribute-mapper",
     "config": {
      "user.attribute": "country",
      "claim.name": "country",
      "jsonType.label": "String",
      "access.token.claim": "true",
      "id.token.claim": "true",
      "userinfo.token.claim": "true",
      "introspection.token.claim": "true"
     }
    }
   ]
  },
  {
   "clientId": "another-audience",
   "publicClient": true,
   "standardFlowEnabled": false,
   "directAccessGrantsEnabled": true,
   "protocolMappers": [
    {
     "name": "roles",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-usermodel-realm-role-mapper",
     "config": {
      "claim.name": "roles",
      "multivalued": "true",
      "jsonType.label": "String",
      "access.token.claim": "true",
      "id.token.claim": "true",
      "userinfo.token.claim": "true",
      "introspection.token.claim": "true"
     }
    }
   ]
  }
 ],
 "users": [
  {
   "username": "alice",
   "enabled": true,
   "email": "alice@example.com",
   "emailVerified": true,
   "firstName": "Alice",
   "lastName": "Conformance",
   "credentials": [
    {
     "type": "password",
     "value": "alice-password",
     "temporary": false
    }
   ],
   "realmRoles": [
    "backend"
   ]
  },
  {
   "username": "bob",
   "enabled": true,
   "email": "bob@example.com",
   "emailVerified": true,
   "firstName": "Bob",
   "lastName": "Conformance",
   "credentials": [
    {
     "type": "password",
     "value": "bob-password",
     "temporary": false
    }
   ],
   "realmRoles": [
    "reader"
   ]
  },
  {
   "username": "carla",
   "enabled": true,
   "email": "carla@example.com",
   "emailVerified": true,
   "firstName": "Carla",
   "lastName": "Conformance",
   "credentials": [
    {
     "type": "password",
     "value": "carla-password",
     "temporary": false
