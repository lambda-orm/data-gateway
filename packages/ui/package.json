{
	"name": "@lambdaorm/ui",
	"version": "0.5.0",
	"description": "React components to write, check and run λORM queries against a λORM data-gateway",
	"author": "Flavio Lionel Rita <flaviolrita@proton.me>",
	"license": "MIT",
	"main": "./build/lib/index.cjs",
	"module": "./build/lib/index.js",
	"types": "./build/lib/index.d.ts",
	"exports": {
		".": {
			"types": "./build/lib/index.d.ts",
			"import": "./build/lib/index.js",
			"require": "./build/lib/index.cjs"
		},
		"./styles.css": "./build/lib/styles.css"
	},
	"sideEffects": [
		"*.css"
	],
	"private": true,
	"homepage": "https://github.com/lambda-orm/core/tree/main/packages/ui#readme",
	"bugs": {
		"url": "https://github.com/lambda-orm/lambdaorm/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lambda-orm/core.git",
		"directory": "packages/ui"
	},
	"scripts": {
		"lint": "npx eslint -c ../../eslint.config.js \"src/**/*.{ts,tsx}\"",
		"declarations": "node scripts/queryableDeclarations.mjs",
		"build": "npm run declarations && npx vite build && npx tsc -p tsconfig.build.json",
		"test": "npx vitest run",
		"dist": "node ../../scripts/dist.mjs"
	},
	"peerDependencies": {
		"react": ">=18",
		"react-dom": ">=18"
	},
	"dependencies": {
		"elkjs": "0.12.0",
		"js-yaml": "^4.1.0",
		"lucide-react": "1.70.0",
		"monaco-editor": "0.52.2"
	},
	"keywords": [
		"lambdaorm",
		"orm",
		"react",
		"monaco",
		"query",
		"data-gateway"
	],
	"devDependencies": {
		"@testing-library/dom": "10.4.0",
		"@testing-library/react": "16.3.0",
		"@types/js-yaml": "4.0.9",
		"@types/react": "18.3.23",
		"@types/react-dom": "18.3.7",
		"@vitejs/plugin-react": "4.5.0",
		"jsdom": "26.1.0",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"typescript": "5.8.3",
		"vite": "6.3.5",
		"vitest": "3.1.4"
	}
}
