{
  "name": "@lambdaorm/data-gateway-ide",
  "version": "1.1.0",
  "private": true,
  "description": "λORM data-gateway IDE: connects to data-gateways (their schemas, workspaces and projects stay in them) to write and run queries, model schemas and run commands. Its backend serves the app and reaches the gateways' management port.",
  "license": "MIT",
  "author": "Flavio Lionel Rita",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambda-orm/data-gateway.git",
    "directory": "packages/ide"
  },
  "homepage": "https://github.com/lambda-orm/data-gateway/tree/main/packages/ide#readme",
  "type": "module",
  "scripts": {
    "lint": "eslint -c ../../eslint.config.js \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "vite build",
    "test": "node --test server/server.test.mjs",
    "start": "node server/server.mjs",
    "dev": "vite",
    "dist": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@lambdaorm/ui": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.0",
    "lucide-react": "1.70.0",
    "monaco-editor": "0.52.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "swagger-ui-react": "5.34.1",
    "vite": "6.3.5"
  },
  "bugs": {
    "url": "https://github.com/lambda-orm/data-gateway/issues"
  }
}
