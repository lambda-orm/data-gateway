  "description": "Gateway that exposes the functionality of the λORM library",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "./build/lib/index.js",
  "types": "./build/lib/index.d.ts",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambda-orm/data-gateway.git",
    "directory": "packages/data-gateway"
  },
  "standard-version": {
    "header": "# Changelog\n\nAll notable changes to this project will be documented in this file.\n\n## Versions\n"
  },
  "keywords": [
    "orm",
    "lambdaorm",
    "data-gateway",
    "gateway"
  ],
  "author": "Flavio Lionel Rita <flaviolrita@proton.me>",
  "bugs": {
    "url": "https://github.com/lambda-orm/data-gateway/issues"
  },
  "homepage": "https://github.com/lambda-orm/data-gateway/tree/main/packages/data-gateway#readme",
  "dependencies": {
    "3xpr": "^5.3.1",
    "@lambdaorm/base": "^3.11.1",
