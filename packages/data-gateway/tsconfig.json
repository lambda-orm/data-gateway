{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "sourceMap": true,
    "target": "ES2020",
    "module": "commonjs",
    "typeRoots": [
      "../../node_modules/@types"
    ],
    "composite": true,
    "rootDir": "./src",
    "outDir": "./build",
    "baseUrl": "./src",
    "tsBuildInfoFile": "./build/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "**/__tests__/**",
    "**/__jest__/**"
  ]
}
