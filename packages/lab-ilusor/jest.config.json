{
	"rootDir": ".",
	"testMatch": [
		"<rootDir>/tests/**/*.spec.ts"
	],
	"testTimeout": 30000,
	"maxWorkers": 1,
	"transform": {
		"^.+\\.ts$": [
			"ts-jest",
			{
				"tsconfig": "<rootDir>/../../../../tsconfig.json",
				"diagnostics": false
			}
		]
	},
	"moduleFileExtensions": [
		"ts",
		"js",
		"json",
		"node"
	],
	"moduleNameMapper": {
		"^@lambdaorm/base$": "<rootDir>/../../../../../base/build/lib",
		"^@lambdaorm/base/(.*)$": "<rootDir>/../../../../../base/build/lib/$1"
	},
	"globalSetup": "<rootDir>/globalSetup.ts"
}
