    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.4",
    "@types/express": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.5",
    "@types/node": "^22.15.26",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
