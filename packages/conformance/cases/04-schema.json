[
	{
		"name": "schema: entities, and an entity by its name",
		"steps": [
			{ "operation": "entities", "expect": { "length": 5 } },
			{ "operation": "entity", "args": { "entity": "Categories" }, "expect": { "match": { "name": "Categories", "primaryKey": [ "id" ], "uniqueKey": [ "name" ] } } }
		]
	},
	{
		"name": "schema: search by part of a name, and some entities described",
		"steps": [
			{ "operation": "search", "args": { "text": "Products.categ" }, "expect": { "result": { "matches": [ "Products.categoryId: integer", "Products.category → Categories" ] } } },
			{ "operation": "search", "args": { "text": "Prodcts" }, "expect": { "result": { "matches": [], "didYouMean": [ "products", "Products", "product" ] } } },
			{ "operation": "describe", "args": { "entities": [ "Categories", "Categorie" ] }, "expect": { "match": { "notFound": [ { "name": "Categorie", "didYouMean": [ "Categories" ] } ] } } }
		]
	},
	{
		"name": "error not_found: a name that does not exist in the schema",
		"steps": [
			{ "operation": "entity", "args": { "entity": "Nope" }, "expect": { "error": { "code": "not_found", "name": "NotFoundError" } } },
			{ "operation": "enum", "args": { "enum": "Nope" }, "expect": { "error": { "code": "not_found", "name": "NotFoundError" } } },
			{ "operation": "source", "args": { "source": "Nope" }, "expect": { "error": { "code": "not_found", "name": "NotFoundError" } } },
			{ "operation": "mapping", "args": { "mapping": "Nope" }, "expect": { "error": { "code": "not_found", "name": "NotFoundError" } } },
			{ "operation": "stage", "args": { "stage": "Nope" }, "expect": { "error": { "code": "not_found", "name": "NotFoundError" } } }
		]
	},
	{
		"name": "schema: sources, stages, views and enums",
		"steps": [
			{ "operation": "sources", "expect": { "result": [ { "name": "Northwind", "dialect": "PostgreSQL" } ] } },
			{ "operation": "source", "args": { "source": "Northwind" }, "expect": { "result": { "name": "Northwind", "dialect": "PostgreSQL" } } },
			{ "operation": "stages", "expect": { "result": [ { "name": "default", "sources": [ { "name": "Northwind" } ] } ] } },
			{ "operation": "stage", "args": { "stage": "default" }, "expect": { "result": { "name": "default", "sources": [ { "name": "Northwind" } ] } } },
			{ "operation": "views", "expect": { "result": [ "default", "sales" ] } },
			{ "operation": "enums", "expect": { "result": [] } }
		]
	},
	{
		"name": "schema: version, domain and mappings",
		"steps": [
			{ "operation": "schemaVersion", "expect": { "keys": [ "version" ] } },
			{ "operation": "domain", "expect": { "keys": [ "entities" ] } },
			{ "operation": "mappings", "expect": { "match": [ { "name": "default" } ] } }
		]
	},
	{
		"name": "stage: exists",
		"operation": "stageExists",
		"args": { "stage": "default" },
		"expect": { "result": { "exists": true } }
	},
	{
		"name": "gateway: version and health",
		"steps": [
			{ "operation": "version", "expect": { "keys": [ "version" ] } },
			{ "operation": "health", "expect": { "keys": [ "message", "time", "uptime" ] } }
		]
	}
]
