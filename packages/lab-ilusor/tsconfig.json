{
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": false,
    "moduleResolution": "node",
    "target": "ES2020",
    "module": "commonjs",
    "noEmit": true,
    "typeRoots": ["../../node_modules/@types"]
  },
  "include": ["*.ts", "tests/**/*.ts"]
}
