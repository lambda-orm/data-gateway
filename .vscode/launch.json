{
	// Debugging on Linux (also macOS): the gateway from its sources, the backend of the IDE, and the IDE in Chrome.
	// "IDE: all" starts the three: the IDE opens on http://localhost:5173 (vite, hot reload). In it, a connection to
	// http://127.0.0.1:19199 (the management of the dev gateway) with the API key dev-modeler-key.
	// "IDE desktop: all": the gateway and the desktop IDE (Electron), its main process and its window.
	"version": "0.2.0",
	"configurations": [
		{
			"name": "data-gateway (dev)",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}/packages/data-gateway/dev",
			"runtimeArgs": ["--import", "tsx"],
			"program": "${workspaceFolder}/packages/data-gateway/src/lib/index.ts",
			"env": { "DATA_GATEWAY_CONFIG_PATH": "${workspaceFolder}/packages/data-gateway/dev/data-gateway.config.yaml" },
			"preLaunchTask": "data-gateway: dev workspace",
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"],
			"autoAttachChildProcesses": true
		},
		{
			"name": "ide: backend",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/packages/ide/server/server.mjs",
			"env": { "PORT": "8080", "HOST": "127.0.0.1", "DATA_GATEWAY_IDE_TARGETS": "*" },
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		},
		{
			"name": "ide: Chrome (vite)",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}/packages/ide",
			"preLaunchTask": "ide: vite",
			"userDataDir": "${workspaceFolder}/.vscode/.chrome-ide"
		},
		{
			"name": "ide: backend with the built app",
			"type": "node",
			"request": "launch",
			"program": "${workspaceFolder}/packages/ide/server/server.mjs",
			"env": { "PORT": "8080", "HOST": "127.0.0.1", "DATA_GATEWAY_IDE_TARGETS": "*" },
			"preLaunchTask": "ide: build",
			"console": "integratedTerminal",
			"serverReadyAction": { "pattern": "listening on [^:]+:(\\d+)", "uriFormat": "http://localhost:%s", "action": "debugWithChrome" },
			"skipFiles": ["<node_internals>/**"]
		},
		{
			// the desktop IDE (Electron) from its sources: its main process here, its window with "ide-desktop: window"
			"name": "ide-desktop: main",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}/packages/ide-desktop",
			"runtimeExecutable": "${workspaceFolder}/packages/ide-desktop/node_modules/.bin/electron",
			"args": [".", "--remote-debugging-port=9223"],
			"preLaunchTask": "ide: build",
			"outputCapture": "std",
			"skipFiles": ["<node_internals>/**"]
		},
		{
			// the page of the desktop IDE (app://ide), once its main process runs
			"name": "ide-desktop: window",
			"type": "chrome",
			"request": "attach",
			"port": 9223,
			"webRoot": "${workspaceFolder}/packages/ide",
			"timeout": 30000
		},
		{
			"name": "data-gateway: test (current file)",
			"type": "node",
			"request": "launch",
			"cwd": "${workspaceFolder}/packages/data-gateway",
			"program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
			"args": ["--config", "${input:jestConfig}", "--runInBand", "${file}"],
			"console": "integratedTerminal",
			"skipFiles": ["<node_internals>/**"]
		}
	],
	"compounds": [
		{
			"name": "IDE desktop: all (gateway + Electron)",
			"configurations": ["data-gateway (dev)", "ide-desktop: main", "ide-desktop: window"],
			"stopAll": true
		},
		{
			"name": "IDE: all (gateway + backend + Chrome)",
			"configurations": ["data-gateway (dev)", "ide: backend", "ide: Chrome (vite)"],
			"stopAll": true
		}
	],
	"inputs": [
		{ "id": "jestConfig", "type": "pickString", "description": "Unit or integration tests", "options": ["jest-config.json", "jest-integration-config.json"], "default": "jest-config.json" }
	]
}
