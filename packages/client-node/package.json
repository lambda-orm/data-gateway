{
	"name": "@lambdaorm/data-gateway-client",
	"version": "0.1.0",
	"description": "Client of the λORM Data Gateway: the same queries and the same API over REST, WebSocket or MCP, chosen by the connection string",
	"author": "Flavio Lionel Rita <flaviolrita@proton.me>",
	"license": "MIT",
	"engines": {
		"node": ">=22"
	},
	"main": "./build/lib/index.js",
	"types": "./build/lib/index.d.ts",
	"exports": {
		".": {
			"require": "./build/lib/index.js",
			"types": "./build/lib/index.d.ts"
		}
	},
	"private": true,
	"homepage": "https://lambda-orm.github.io/wiki/data-gateway/",
	"bugs": {
		"url": "https://github.com/lambda-orm/lambdaorm/issues"
	},
	"scripts": {
		"lint": "npx eslint -c ../../eslint.config.js \"src/**/*.ts\"",
		"build": "npx tsc",
		"test": "npx jest --config ./jest-config.json",
		"conformance": "npx tsx conformance/run.ts",
		"dist": "node ../../scripts/dist.mjs"
	},
	"dependencies": {
		"@lambdaorm/base": "workspace:*",
		"3xpr": "^5.3.1"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.15.26",
		"jest": "^29.7.0",
		"ts-jest": "^29.1.4",
		"tsx": "^4.21.0",
		"typescript": "^5.8.3"
	},
	"keywords": [
		"lambdaorm",
		"data gateway",
		"client",
		"orm",
		"query",
		"rest",
		"websocket",
		"json-rpc",
		"mcp",
		"model context protocol"
	]
}
